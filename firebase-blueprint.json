{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information",
      "type": "object",
      "properties": {
        "mobile": {
          "type": "string",
          "pattern": "^01[3-9][0-9]{8}$",
          "description": "Bangladeshi 11-digit mobile number"
        },
        "role": {
          "type": "string",
          "enum": ["user"],
          "description": "User role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["mobile", "role", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin identity and access",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["email"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User CV and profile conforming to Teletalk requirements",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number" },
        "data": { "type": "object" },
        "presentDistrict": { "type": "string" },
        "permanentDistrict": { "type": "string" },
        "mobile": { "type": "string" },
        "photoPath": { "type": "string" },
        "signaturePath": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["schemaVersion", "data", "updatedAt"]
    },
    "Job": {
      "title": "Job",
      "description": "Job post and circular information",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "deadline": { "type": "string" },
        "applyLink": { "type": "string" },
        "applyServiceEnabled": { "type": "boolean" },
        "applicationFee": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "posts": { "type": "array" },
        "seoTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "focusKeyword": { "type": "string" },
        "tags": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "published", "scheduled"] },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "slug", "category", "status", "createdAt"]
    },
    "Application": {
      "title": "Application",
      "description": "User job application record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "mobile": { "type": "string" },
        "fullName": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "postName": { "type": "string" },
        "postCount": { "type": "number" },
        "district": { "type": "string" },
        "educationLevel": { "type": "string" },
        "smsNumber": { "type": "string" },
        "termsAccepted": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["waiting", "apply_now", "checking", "payment_now", "applied", "rejected", "correction"]
        },
        "fee": { "type": "object" },
        "payment": { "type": "object" },
        "softCopyPath": { "type": "string" },
        "paidCopyPath": { "type": "string" },
        "correctionNote": { "type": "string" },
        "rejectReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "mobile", "fullName", "jobId", "postName", "status", "termsAccepted", "fee", "payment", "createdAt"]
    },
    "TrxId": {
      "title": "TrxId",
      "description": "Unique transaction ID tracking record",
      "type": "object",
      "properties": {
        "appId": { "type": "string" },
        "uid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["appId", "uid", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "appId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "title", "body", "read", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System settings such as payment information",
      "type": "object",
      "properties": {
        "bkashNumber": { "type": "string" },
        "rocketNumber": { "type": "string" },
        "instructions": { "type": "string" },
        "whatsappNumber": { "type": "string" }
      }
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam schedule and result notices",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "createdAt"]
    },
    "File": {
      "title": "File",
      "description": "Base64 encoded file storage in Firestore",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "kind": { "type": "string", "enum": ["photo", "signature", "screenshot", "softcopy", "paidcopy", "cover"] },
        "appId": { "type": "string" },
        "mime": { "type": "string" },
        "sizeBytes": { "type": "number" },
        "data": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerUid", "kind", "mime", "sizeBytes", "data"]
    },
    "Feed": {
      "title": "Feed",
      "description": "Aggregated latest job postings for single-read homepage feed",
      "type": "object",
      "properties": {
        "posts": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["posts"]
    },
    "Otp": {
      "title": "Otp",
      "description": "Registration OTP verification code",
      "type": "object",
      "properties": {
        "mobile": { "type": "string" },
        "code": { "type": "string" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["mobile", "code", "expiresAt"]
    },
    "SmsQueueItem": {
      "title": "SmsQueueItem",
      "description": "Outbound SMS queue for Android SMS Gateway dispatch",
      "type": "object",
      "properties": {
        "recipient": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "sent", "failed"] },
        "type": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["recipient", "body", "status"]
    }
  },
  "firestore": {
    "/otps/{mobile}": {
      "schema": "Otp",
      "description": "Transient registration OTP verification records"
    },
    "/smsQueue/{jobId}": {
      "schema": "SmsQueueItem",
      "description": "SMS queue jobs processed by Android Gateway"
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile metadata"
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Administrator registry"
    },
    "/profiles/{uid}": {
      "schema": "Profile",
      "description": "Full candidate CV details"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job circulars"
    },
    "/applications/{appId}": {
      "schema": "Application",
      "description": "Submitted job applications"
    },
    "/trxIds/{trxId}": {
      "schema": "TrxId",
      "description": "Unique transaction IDs to avoid double-spend"
    },
    "/notifications/{id}": {
      "schema": "Notification",
      "description": "Candidate notifications"
    },
    "/settings/{id}": {
      "schema": "Setting",
      "description": "Global application settings"
    },
    "/exams/{id}": {
      "schema": "Exam",
      "description": "Exam and result notices"
    },
    "/files/{fileId}": {
      "schema": "File",
      "description": "Base64 user media, screenshots, and circular cover files"
    },
    "/feed/{id}": {
      "schema": "Feed",
      "description": "Feed documents for zero-cost single read home/list pages"
    }
  }
}

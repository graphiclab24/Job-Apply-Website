rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(db)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'habiblinkage@gmail.com' ||
          request.auth.token.email == 'masterboom2040@gmail.com' ||
          request.auth.token.email == 'admin@studyonlinebd.com' ||
          request.auth.token.email.lower() == 'habiblinkage@gmail.com' ||
          request.auth.token.email.lower() == 'masterboom2040@gmail.com' ||
          request.auth.token.email.lower() == 'admin@studyonlinebd.com'
        ))
      );
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin() || (
        signedIn() && (
          request.auth.token.email == 'habiblinkage@gmail.com' ||
          request.auth.token.email == 'masterboom2040@gmail.com' ||
          request.auth.token.email == 'admin@studyonlinebd.com' ||
          request.auth.token.email.lower() == 'habiblinkage@gmail.com' ||
          request.auth.token.email.lower() == 'masterboom2040@gmail.com' ||
          request.auth.token.email.lower() == 'admin@studyonlinebd.com'
        )
      );
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      allow update: if (isOwner(uid) && request.resource.data.role == 'user') || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /jobs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feed/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /files/{fileId} {
      allow read: if resource.data.kind == 'cover' || (signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin()));
      allow create, update: if isAdmin() || (
        signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind in ['photo', 'signature', 'screenshot']
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /exams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trxIds/{trxId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /counters/{id} {
      allow read, write: if signedIn();
    }

    match /applications/{appId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if isAdmin() || (
        signedIn() && resource.data.uid == request.auth.uid
        && resource.data.status == 'checking'
        && request.resource.data.status in ['payment_now', 'correction']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'correctionNote', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    match /otps/{mobile} {
      allow read: if true;
      allow create, update: if mobile.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.mobile == mobile
        && request.resource.data.code.size() <= 4;
      allow delete: if true;
    }

    match /smsQueue/{jobId} {
      allow read: if true;
      allow create: if request.resource.data.recipient.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 160
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['otp', 'system'];
      allow update: if request.resource.data.status in ['pending', 'sent', 'failed'];
      allow delete: if isAdmin();
    }

    match /short_links/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'lastClickedAt'])
      );
    }
  }
}

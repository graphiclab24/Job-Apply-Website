rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }

    // অ্যাডমিন: admins collection-এ থাকা UID অথবা নির্দিষ্ট ২টি ইমেইল
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'habiblinkage@gmail.com' ||
          request.auth.token.email.lower() == 'masterboom2040@gmail.com'
        )) ||
        exists(/databases/$(db)/documents/admins/$(request.auth.uid))
      );
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      allow update: if (isOwner(uid) && request.resource.data.role == 'user') || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /jobs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feed/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /files/{fileId} {
      allow read: if resource.data.kind == 'cover'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      allow create, update: if (signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind in ['photo', 'signature', 'screenshot'])
        || isAdmin();
      allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
    }

    match /exams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trxIds/{trxId} {
      // পেমেন্ট ডুপ্লিকেট চেকের জন্য signed-in ব্যবহারকারী পড়তে পারে
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /counters/{id} {
      allow read, write: if signedIn();
    }

    match /applications/{appId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if (
        signedIn() && resource.data.uid == request.auth.uid
        && resource.data.status == 'checking'
        && request.resource.data.status in ['payment_now', 'correction']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'correctionNote', 'updatedAt'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin();
    }

    // OTP: ক্লায়েন্ট কোড এখনও OTP পড়ে, তাই সাময়িকভাবে খোলা।
    // TODO: OTP যাচাই Worker-এ সরিয়ে read: if false করতে হবে।
    match /otps/{mobile} {
      allow read: if true;
      allow create, update: if mobile.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.mobile == mobile
        && request.resource.data.code.size() <= 4;
      allow delete: if true;
    }

    // SMS queue-তে ফোন নম্বর ও OTP-এর লেখা থাকে, তাই শুধু অ্যাডমিন পড়তে পারবে
    match /smsQueue/{jobId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.recipient.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 160
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['otp', 'system'];
      allow update, delete: if isAdmin();
    }

    match /short_links/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'lastClickedAt'])
      );
    }
  }
}
